# Copy to .env and fill in. The .env file is gitignored.

# Local development Postgres (matches compose.yaml).
# In production this points at the Neon connection string instead.
DATABASE_URL=postgres://etymyriad:etymyriad@localhost:5432/etymyriad

# Where the ETL reads the downloaded Wiktextract dump from.
WIKTEXTRACT_DUMP=./data/raw/indo-european.jsonl

# The enwiktionary dump date, pinned into every source_ref for provenance.
WIKTEXTRACT_DUMP_DATE=2026-06-01
