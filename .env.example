# Every value below already defaults to this in source
# (web/src/lib/server/db.ts, etl/src/etymyriad/config.py)
# copy to .env only to override one for this machine. Never put a live
# Neon URL here; pass it inline for a one-off command instead.

# Local development Postgres. Production reads its URL from a Cloudflare
# secret.
DATABASE_URL=postgres://etymyriad:etymyriad@localhost:5432/etymyriad

# Where the ETL reads the downloaded Wiktextract dump from.
WIKTEXTRACT_DUMP=./data/raw/indo-european.jsonl

# The enwiktionary dump date, pinned into every source_ref for provenance.
WIKTEXTRACT_DUMP_DATE=2026-09-02
