# DATABASE_URL already defaults to this value in source
# (web/src/lib/server/db.ts, etl/src/etymyriad/config.py). Copy to .env
# only to override a value for this machine. Never put a live Neon URL
# here; pass it inline for a one-off command instead.

# Local development Postgres. Production reads its URL from a Cloudflare
# secret.
DATABASE_URL=postgres://etymyriad:etymyriad@localhost:5432/etymyriad

# The dump every ETL reader uses. Unset, it is
# data/etymyriad-data.jsonl, which `etymyriad filter` writes.
# WIKTEXTRACT_DUMP=./data/raw-wiktextract-data.jsonl.gz

# The enwiktionary dump date, pinned into every source_ref for provenance.
# It has no default, and `load` and `all` require it.
# WIKTEXTRACT_DUMP_DATE=2026-09-02
