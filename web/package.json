{
  "name": "etymyriad-web",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "prepare": "svelte-kit sync",
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest run",
    "test:unit": "vitest run --project server --project client",
    "test:e2e": "playwright test",
    "snapshot:default-tree": "node scripts/snapshotDefaultTree.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint --fix ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@sveltejs/adapter-cloudflare": "^8.0.2",
    "@sveltejs/kit": "^3.2.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/d3-zoom": "^3.0.9",
    "@types/node": "^26.6.6",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.8",
    "vitest": "^5.0.4",
    "wrangler": "^4.149.0"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/libre-baskerville": "^5.3.0",
    "@fontsource/noto-sans-avestan": "^5.3.0",
    "@fontsource/noto-sans-brahmi": "^5.3.0",
    "@fontsource/noto-sans-cuneiform": "^5.3.0",
    "@fontsource/noto-sans-egyptian-hieroglyphs": "^5.3.0",
    "@fontsource/noto-sans-gothic": "^5.3.0",
    "@fontsource/noto-sans-imperial-aramaic": "^5.3.0",
    "@fontsource/noto-sans-kharoshthi": "^5.3.0",
    "@fontsource/noto-sans-old-italic": "^5.3.0",
    "@fontsource/noto-sans-old-persian": "^5.3.0",
    "@fontsource/noto-sans-phoenician": "^5.3.0",
    "@fontsource/noto-sans-sharada": "^5.3.0",
    "@neondatabase/serverless": "^1.2.0",
    "bits-ui": "~2.19.5",
    "d3-hierarchy": "^3.1.2",
    "d3-zoom": "^3.0.0",
    "postgres": "^4.1.0",
    "svelte-sonner": "^1.2.1"
  }
}
