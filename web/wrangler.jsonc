{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "etymyriad",
	"workers_dev": false,
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2025-01-01",
	"compatibility_flags": ["nodejs_als"],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	}
}
